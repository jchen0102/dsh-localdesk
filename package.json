{
  "name": "dsh-localdesk",
  "version": "0.4.3",
  "private": false,
  "type": "module",
  "description": "A local change observatory for DSH: Sessions, jobs, schedules, goals, Team tasks, Codex sessions, the WeChat channel, app data changes and running local apps in one read-only desk.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "assets",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "workbench",
    "observability",
    "local"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node test/probe.mjs",
    "preflight": "node --check index.js && node --check client.js && node test/probe.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jchen0102/dsh-localdesk.git"
  },
  "homepage": "https://github.com/jchen0102/dsh-localdesk#readme",
  "bugs": {
    "url": "https://github.com/jchen0102/dsh-localdesk/issues"
  }
}
